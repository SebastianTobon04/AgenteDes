# Copia este archivo a .env y completa SOLO la clave del proveedor que uses. NUNCA subas .env al repositorio.
# --- Modelo (pasos que consultan una API de PAGO: agente interactivo y scripts/conversaciones_reales.py) ---
DES_PROVIDER=anthropic          # anthropic | openai
DES_MODEL=claude-sonnet-4-5     # id del modelo del proveedor (debe soportar llamadas a herramientas)
ANTHROPIC_API_KEY=              # requerida si DES_PROVIDER=anthropic
OPENAI_API_KEY=                 # requerida si DES_PROVIDER=openai
# --- Servidor MCP ---
DES_MCP_URL=http://127.0.0.1:8765/mcp   # dirección que usa el cliente/agente
DES_MCP_HOST=127.0.0.1                  # host/puerto en los que escucha servidor_mcp.py
DES_MCP_PORT=8765
# --- Aplicación ---
DES_ROL=observador              # observador | operador (lo fija la aplicación, no el usuario del chat)
DES_META=1                      # meta de espera promedio en minutos (>= 0)
DES_SALIDA_DIR=evidencias/simulaciones  # CSV de resultados y muestras que escribe el servidor MCP
DES_TRAZAS_DIR=evidencias/trazas        # bitácora JSONL por hilo
